            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Köretek\",\n  \"description\": \"Sültek, saláták és köretek\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/categories/3", "host": ["{{baseUrl}}"], "path": ["categories", "3"] }
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/categories/1", "host": ["{{baseUrl}}"], "path": ["categories", "1"] }
          }
        }
